config BR2_PACKAGE_XADC_LNX
	bool "XADC monitor"
	depends on BR2_arm && BR2_cortex_a9
	depends on BR2_LINUX_KERNEL
	help
		Application on Linux for programming other FPGA or debug insert FPGA using Ethernet
if BR2_PACKAGE_XADC_LNX

config BR2_PACKAGE_XADC_LNX_PTH_DEVICE
	string "path device to iio"
	default "/sys/bus/iio/devices/iio:device0"

endif # BR2_PACKAGE_XADC_LNX
